# Copy this file to .env.local and fill in values
ANTHROPIC_API_KEY=your_api_key_here
DATABASE_URL="postgresql://localhost:5432/mathtutor?schema=public"

# Comma-separated emails allowed to view the admin system-health dashboard (/admin)
ADMIN_EMAILS=you@example.com

# Transactional email (parent confirmation + team lead notifications)
RESEND_API_KEY=your_resend_key_here
# Inbox that receives new consultation-request notifications (defaults to hello@socratutoring.com)
TEAM_EMAIL=hello@socratutoring.com

# Public inline-embed URL for the consultation scheduler (Cal.com or Calendly).
# Example (Cal.com):  https://cal.com/your-team/consultation
# Example (Calendly): https://calendly.com/your-team/free-consultation
# Left blank, /get-started still captures the lead and shows a fallback message.
NEXT_PUBLIC_BOOKING_URL=
