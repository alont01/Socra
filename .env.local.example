# Copy this file to .env.local and fill in values
ANTHROPIC_API_KEY=your_api_key_here
DATABASE_URL="postgresql://localhost:5432/mathtutor?schema=public"

# Comma-separated emails allowed to view the admin system-health dashboard (/admin)
ADMIN_EMAILS=you@example.com

# Transactional email (parent confirmation + team lead notifications)
RESEND_API_KEY=your_resend_key_here
# Inbox that receives new consultation-request notifications (defaults to team@socratutoring.com)
TEAM_EMAIL=team@socratutoring.com

# When a parent creates a child, the student is auto-assigned to this tutor so
# live sessions work without an extra step. Falls back to the only tutor if
# exactly one exists; otherwise the student is left unassigned.
DEFAULT_TUTOR_EMAIL=

# Inline-embed URL for the consultation scheduler (Cal.com or Calendly). Read at
# RUNTIME (no rebuild needed to change it), used by /get-started and the parent
# confirmation email.
# Example (Cal.com):  https://cal.com/your-team/consultation
# Example (Calendly): https://calendly.com/your-team/free-consultation
# Left blank, /get-started still captures the lead and shows a fallback message.
BOOKING_URL=

# Monthly billing (/admin/billing). Left blank, hours are still tracked and
# shown, but invoices can't be sent until this is set. Prefer a RESTRICTED key
# (rk_...) limited to Customers + Invoices write over a full secret key. Use a
# test-mode key until you're ready to take real payments.
STRIPE_SECRET_KEY=
# Signing secret for the Stripe webhook (/api/stripe/webhook). WITHOUT THIS,
# invoices are sent but never move to "paid" — payment status stops updating.
# Test and live mode have DIFFERENT secrets; local dev uses the one printed by
# `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=
# Flat hourly rate charged to every family, in whole dollars. Defaults to 75.
HOURLY_RATE_USD=75
# Minutes of overrun allowed past a session's booked length before billing stops
# counting. Defaults to 10.
BILLING_GRACE_MINUTES=10

# Shared secret for scheduled jobs (stale-session sweeper + integration health
# check). Must match the CRON_SECRET repository secret used by the workflows in
# .github/workflows/. Generate with: openssl rand -hex 32
CRON_SECRET=

# Integration health: /admin shows a live probe of every credential above, and
# .github/workflows/check-integrations.yml runs it hourly, emailing TEAM_EMAIL
# when one changes state. Nothing extra to configure — it reads the same keys.
# Note these keys do NOT expire; the check catches a key that was rolled, never
# set on the host, or is being rejected by the provider.
