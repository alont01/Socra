# Copy this file to .env.local and fill in values
ANTHROPIC_API_KEY=your_api_key_here
DATABASE_URL="postgresql://localhost:5432/mathtutor?schema=public"

# Comma-separated emails allowed to view the admin system-health dashboard (/admin)
ADMIN_EMAILS=you@example.com

# Transactional email (parent confirmation + team lead notifications)
RESEND_API_KEY=your_resend_key_here
# Inbox that receives new consultation-request notifications (defaults to team@socratutoring.com)
TEAM_EMAIL=team@socratutoring.com

# When a parent creates a child, the student is auto-assigned to this tutor so
# live sessions work without an extra step. Falls back to the only tutor if
# exactly one exists; otherwise the student is left unassigned.
DEFAULT_TUTOR_EMAIL=

# Inline-embed URL for the consultation scheduler (Cal.com or Calendly). Read at
# RUNTIME (no rebuild needed to change it), used by /get-started and the parent
# confirmation email.
# Example (Cal.com):  https://cal.com/your-team/consultation
# Example (Calendly): https://calendly.com/your-team/free-consultation
# Left blank, /get-started still captures the lead and shows a fallback message.
BOOKING_URL=

# Monthly billing (/admin/billing). Left blank, hours are still tracked and
# shown, but invoices can't be sent until this is set. Use a test-mode key
# (sk_test_...) until you're ready to take real payments.
STRIPE_SECRET_KEY=
# Flat hourly rate charged to every family, in whole dollars. Defaults to 75.
HOURLY_RATE_USD=75
