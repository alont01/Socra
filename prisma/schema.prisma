generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  // Optional login handle for parent-created student accounts (kids without an
  // email). Login accepts either email or username. Stored lowercased.
  username      String?  @unique
  passwordHash  String?
  role          String   @default("STUDENT")
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  studentProfile       StudentProfile?       @relation("UserProfile")
  parentProfile        ParentProfile?        @relation("UserParent")
  tutorProfile         TutorProfile?         @relation("UserTutor")
  passwordResetTokens  PasswordResetToken[]
  emailVerification    EmailVerification?
}

// Short-lived 6-digit code emailed at email/password signup. One active record
// per user; the code is stored hashed.
model EmailVerification {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model StudentProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation("UserProfile", fields: [userId], references: [id], onDelete: Cascade)
  name           String
  gradeLevel     String   @default("")
  mathTopics     String   @default("[]")
  strengthAreas  String   @default("[]")
  weaknessAreas  String   @default("[]")
  learningStyle  String   @default("")
  goals          String   @default("")
  learningPlan   String   @default("")
  onboardingDone Boolean  @default(false)
  // Matching: desired weekly hours + recurring availability (same JSON format
  // as TutorProfile.availability).
  desiredHoursPerWeek Int    @default(1)
  availability        String @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  parentId       String?
  parent         ParentProfile? @relation("ParentChildren", fields: [parentId], references: [id])
  tutors         TutorStudent[]     @relation("StudentRoster")
  matchOffers    TutorMatchOffer[]  @relation("StudentOffers")
  tutoringSessions TutoringSession[] @relation("TutoringStudent")
  practiceSets     PracticeSet[]
  studentProgress  StudentProgress[]
  masteryHistory   MasteryHistory[]
  parentInvites    ParentInvite[]    @relation("StudentParentInvites")
}

model ParentProfile {
  id             String           @id @default(cuid())
  userId         String           @unique
  user           User             @relation("UserParent", fields: [userId], references: [id], onDelete: Cascade)
  name           String
  onboardingDone Boolean          @default(false)
  // Set lazily on the first invoice sent to this family.
  stripeCustomerId String?        @unique
  children       StudentProfile[] @relation("ParentChildren")
  invoices       Invoice[]
  createdAt      DateTime         @default(now())
}

// A monthly bill sent to a parent: hours actually delivered across all their
// children that period, at the flat hourly rate, invoiced via Stripe. Kept
// locally (not just relying on Stripe as the record) so the admin billing view
// can answer "has this family been billed this month" without a Stripe round
// trip, and so there's an audit trail independent of Stripe.
model Invoice {
  id              String        @id @default(cuid())
  parentId        String
  parent          ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)
  periodStart     DateTime
  periodEnd       DateTime
  hours           Float
  rateUsd         Float
  amountCents     Int
  stripeInvoiceId String?       @unique
  stripeInvoiceUrl String?
  // pending  — claimed locally, Stripe call not yet confirmed
  // sent     — finalized and emailed to the parent
  // paid | failed | uncollectible | void — driven by Stripe webhooks
  status          String        @default("pending")
  sentAt          DateTime?
  paidAt          DateTime?
  // Guards against Stripe's out-of-order webhook delivery: an event older than
  // the one that last set `status` is ignored. See app/api/stripe/webhook.
  statusUpdatedAt DateTime?
  stripeEventId   String?
  // Set when a Stripe call fails, so the admin sees why a retry is needed.
  lastError       String?
  createdAt       DateTime      @default(now())

  // One invoice per family per billing period.
  @@unique([parentId, periodStart, periodEnd])
  @@index([parentId])
  @@index([status])
}

model TutorProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation("UserTutor", fields: [userId], references: [id], onDelete: Cascade)
  name        String
  specialties String   @default("[]")
  bio         String   @default("")
  // Matching setup: weekly capacity + recurring availability blocks
  // (JSON: [{day:0-6,start:"HH:MM",end:"HH:MM"}], America/New_York wall-clock).
  maxHoursPerWeek   Int?
  availability      String   @default("[]")
  acceptingStudents Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  students    TutorStudent[]      @relation("TutorRoster")
  tutoringSessions TutoringSession[] @relation("TutoringTutor")
  matchOffers TutorMatchOffer[]   @relation("TutorOffers")
}

model TutorStudent {
  id        String         @id @default(cuid())
  tutorId   String
  tutor     TutorProfile   @relation("TutorRoster", fields: [tutorId], references: [id], onDelete: Cascade)
  studentId String
  student   StudentProfile @relation("StudentRoster", fields: [studentId], references: [id], onDelete: Cascade)
  // Committed weekly load (for tutor capacity accounting) + lifecycle. A DB-level
  // partial unique index (see migration) enforces at most one active tutor per
  // student, which is what makes offer-accept atomic (first-wins).
  hoursPerWeek Int         @default(1)
  status       String      @default("active") // active | ended
  createdAt DateTime       @default(now())

  @@unique([tutorId, studentId])
  @@index([studentId, status])
}

// A parallel, time-boxed offer to a tutor to take on a student. The matching
// engine creates a batch of these (top candidates); the first tutor to accept
// wins and the siblings are withdrawn.
model TutorMatchOffer {
  id           String   @id @default(cuid())
  studentId    String
  student      StudentProfile @relation("StudentOffers", fields: [studentId], references: [id], onDelete: Cascade)
  tutorId      String
  tutor        TutorProfile   @relation("TutorOffers", fields: [tutorId], references: [id], onDelete: Cascade)
  status       String   @default("pending") // pending | accepted | declined | expired | withdrawn
  score        Float    @default(0)
  overlapSlots String   @default("[]") // JSON of proposed weekly slots
  batch        Int      @default(1)
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  respondedAt  DateTime?

  @@unique([studentId, tutorId])
  @@index([tutorId, status])
  @@index([studentId, status])
}

model TutoringSession {
  id            String    @id @default(cuid())
  tutorId       String
  tutor         TutorProfile   @relation("TutoringTutor", fields: [tutorId], references: [id], onDelete: Cascade)
  studentId     String?
  student       StudentProfile? @relation("TutoringStudent", fields: [studentId], references: [id])
  topic         String    @default("")
  status        String    @default("scheduled")  // scheduled | active | completed | cancelled
  scheduledAt   DateTime?
  // Intended length, set at creation. Billing caps what a session can charge at
  // this (plus a small grace) so a call left open all afternoon doesn't bill for
  // the whole afternoon. See lib/billing.ts billableHours.
  scheduledMinutes Int    @default(60)
  startedAt     DateTime?
  endedAt       DateTime?
  // True when the stale-session sweeper ended this rather than the tutor. Those
  // sessions are billed at the capped duration and flagged for admin review.
  autoClosed    Boolean   @default(false)
  dailyRoomName String?
  dailyRoomUrl  String?
  tutorNotes    String    @default("")
  capturedNotes   String    @default("")
  whiteboardImage String    @default("")
  // Rolling live-caption buffer captured during the call (tutor client). Used as
  // a fallback for analysis when the async Daily VTT fetch comes back empty.
  liveTranscript  String    @default("")
  masteryApplied  Boolean   @default(false) // guards against double-counting mastery on re-analysis
  createdAt       DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  transcript    Transcript?
  analysis      SessionAnalysis?
  practiceSets  PracticeSet[]
  assessment    Assessment?

  @@index([tutorId])
  @@index([studentId])
  @@index([status])
  // Supports the stale-session sweeper's "active and started before X" scan.
  @@index([status, startedAt])
}

// Adaptive diagnostic assessment: one problem at a time, difficulty ladder
// (1-10), up to 10 problems with early-stop on convergence. Grading is hybrid
// — auto-graded to drive real-time progression, with a tutor override/"worked
// together" mark recorded for the holistic result (see AssessmentItem).
model Assessment {
  id                String   @id @default(cuid())
  tutoringSessionId String   @unique
  tutoringSession   TutoringSession @relation(fields: [tutoringSessionId], references: [id], onDelete: Cascade)
  studentId         String
  topic             String
  status            String   @default("in_progress") // in_progress | completed
  currentLevel      Int      @default(5) // 1-10 ladder position
  itemCount         Int      @default(0)
  startedAt         DateTime @default(now())
  completedAt       DateTime?
  // Holistic result, populated on completion.
  estimatedLevel    Int?
  summary           String   @default("")
  strengths         String   @default("[]") // JSON string[]
  gaps              String   @default("[]") // JSON string[]
  items             AssessmentItem[]

  @@index([studentId])
  @@index([status])
}

model AssessmentItem {
  id            String     @id @default(cuid())
  assessmentId  String
  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  index         Int        // 1-based order within the assessment
  level         Int        // difficulty (1-10) this problem was generated at
  topic         String     // specific sub-topic
  question      String
  hint          String     @default("")
  answer        String     // reference answer — never sent to the student client
  studentAnswer String?
  autoCorrect   Boolean?   // result of automatic grading (answersMatch)
  tutorResult   String?    // 'correct' | 'incorrect' | 'worked_together' — tutor override
  finalCorrect  Boolean?   // resolved result recorded for the holistic summary
  createdAt     DateTime   @default(now())
  answeredAt    DateTime?

  @@unique([assessmentId, index])
  @@index([assessmentId])
}

model Transcript {
  id               String          @id @default(cuid())
  tutoringSessionId String         @unique
  tutoringSession  TutoringSession @relation(fields: [tutoringSessionId], references: [id], onDelete: Cascade)
  content          String          @default("")
  speakers         String          @default("[]")
  durationSeconds  Int?
  createdAt        DateTime        @default(now())
}

model SessionAnalysis {
  id                String          @id @default(cuid())
  tutoringSessionId String          @unique
  tutoringSession   TutoringSession @relation(fields: [tutoringSessionId], references: [id], onDelete: Cascade)
  summary           String          @default("")
  conceptsCovered   String          @default("[]")
  studentStrengths  String          @default("[]")
  studentGaps       String          @default("[]")
  tutorFeedback     String          @default("")
  createdAt         DateTime        @default(now())
}

model PracticeSet {
  id                String           @id @default(cuid())
  tutoringSessionId String?
  tutoringSession   TutoringSession? @relation(fields: [tutoringSessionId], references: [id], onDelete: SetNull)
  studentId         String
  student           StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title             String           @default("")
  problems          String           @default("[]")
  status            String           @default("assigned") // draft | assigned — drafts are tutor-only until assigned as homework
  assignedAt        DateTime?
  createdAt         DateTime         @default(now())
  attempts          PracticeSetAttempt[]

  @@index([studentId])
  @@index([tutoringSessionId])
  @@index([studentId, status])
}

model PracticeSetAttempt {
  id            String      @id @default(cuid())
  practiceSetId String
  practiceSet   PracticeSet @relation(fields: [practiceSetId], references: [id], onDelete: Cascade)
  problemIndex  Int
  studentAnswer String      @default("")
  correct       Boolean?
  attemptedAt   DateTime    @default(now())

  @@index([practiceSetId])
}

model StudentProgress {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topic     String
  mastery   Float          @default(0)
  updatedAt DateTime       @updatedAt

  @@unique([studentId, topic])
}

// Time-series of mastery changes — one row each time a topic's mastery is
// updated (session concept coverage or a practice attempt). Powers the
// progress-over-time trend on the student + parent views.
model MasteryHistory {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topic     String
  mastery   Float
  source    String         @default("session") // session | practice
  createdAt DateTime       @default(now())

  @@index([studentId, createdAt])
  @@index([studentId, topic, createdAt])
}

// Operational telemetry for the admin system-health dashboard.
// Written fire-and-forget from lib/metrics.ts; one row per tracked event.
model SystemEvent {
  id           String   @id @default(cuid())
  category     String   // ai | transcript | session | http | error
  name         String   // e.g. "ai.analysis", "session.processed"
  level        String   @default("info") // info | warn | error
  durationMs   Int?
  success      Boolean?
  model        String?  // AI model id, when category = ai
  inputTokens  Int?
  outputTokens Int?
  metadata     String   @default("{}") // JSON blob of extra context
  // Truncated request/response previews (AI calls) for debugging, ~2KB each.
  requestPreview  String?
  responsePreview String?
  createdAt    DateTime @default(now())

  @@index([category, createdAt])
  @@index([level, createdAt])
  @@index([createdAt])
}

// Immutable audit trail of user actions, surfaced in the admin log viewer.
// Written fire-and-forget from lib/audit.ts; one row per audited action.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  // User.id; null for anonymous / failed-auth attempts
  actorEmail String?  // captured even when actorId is null (e.g. failed login)
  actorRole  String?  // STUDENT | TUTOR | PARENT
  action     String   // e.g. "auth.login", "auth.signup", "session.start"
  status     String   @default("success") // success | failure
  targetType String?  // e.g. "session", "student"
  targetId   String?
  ip         String?
  userAgent  String?
  metadata   String   @default("{}") // JSON blob of extra context (never secrets)
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([actorId, createdAt])
  @@index([status, createdAt])
}

// Redeemable invite that links a parent account to a child (student).
// Created by the student themselves or a tutor on their roster; redeemed by a
// parent, which sets StudentProfile.parentId.
model ParentInvite {
  id                 String    @id @default(cuid())
  code               String    @unique
  studentId          String
  student            StudentProfile @relation("StudentParentInvites", fields: [studentId], references: [id], onDelete: Cascade)
  createdByUserId    String
  createdByRole      String    // STUDENT | TUTOR
  status             String    @default("pending") // pending | redeemed | revoked
  expiresAt          DateTime
  redeemedByParentId String?
  redeemedAt         DateTime?
  createdAt          DateTime  @default(now())

  @@index([studentId])
  @@index([status])
}

// Redeemable invite that promotes the redeeming user to TUTOR. Created only by
// an admin (super admin); this is the sole path to a tutor account.
model TutorInvite {
  id                String    @id @default(cuid())
  code              String    @unique
  createdByUserId   String
  note              String    @default("") // optional label, e.g. intended name/email
  status            String    @default("pending") // pending | redeemed | revoked
  expiresAt         DateTime
  redeemedByUserId  String?
  redeemedAt        DateTime?
  createdAt         DateTime  @default(now())

  @@index([status])
}

// A prospective-parent lead captured on the public /get-started page. Not tied
// to a User account — these are inbound consultation requests the team follows
// up on (and/or that get booked via the embedded scheduler).
model ConsultationRequest {
  id           String   @id @default(cuid())
  email        String
  name         String?
  phone        String?
  studentGrade String?
  message      String?
  source       String   @default("website") // e.g. website | flyer | landing
  status       String   @default("new")      // new | contacted | scheduled | closed
  createdAt    DateTime @default(now())

  @@index([email])
  @@index([status])
  @@index([createdAt])
}
